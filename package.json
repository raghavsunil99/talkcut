{
  "name": "cutline",
  "version": "1.0.0",
  "description": "Cutline by Raghav: edit audio and video by editing the transcript.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/edits.test.js test/frame.test.js test/tracks.test.js test/captions.test.js test/text.test.js test/speakers.test.js test/stock.test.js test/cloud.test.js test/keystore.test.js test/projects.test.js test/media.test.js test/transcribe.test.js",
    "build:whisper": "sh scripts/build-whisper.sh",
    "build:facedetect": "sh scripts/build-facedetect.sh",
    "dist:win": "ELECTRON_BUILDER_NSIS_DIR=${ELECTRON_BUILDER_NSIS_DIR:-$HOME/Library/Caches/cutline-nsis-3.13} electron-builder --win nsis --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "resedit": "^2.0.3"
  },
  "author": {
    "name": "Raghav",
    "email": "raghav.sunil99@gmail.com"
  },
  "build": {
    "appId": "com.raghav.cutline",
    "productName": "Cutline by Raghav",
    "copyright": "Built by Raghav",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/*.README",
      "!node_modules/ffmpeg-static/*.LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/win/bin",
          "to": "bin"
        },
        {
          "from": "vendor/win/whisper",
          "to": "whisper"
        },
        {
          "from": "vendor/win/vc_redist.x64.exe",
          "to": "vc_redist.x64.exe"
        },
        {
          "from": "vendor/win/ffmpeg.LICENSE",
          "to": "licenses/ffmpeg.LICENSE"
        }
      ],
      "artifactName": "Cutline-by-Raghav-Setup-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cutline by Raghav",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "installerLanguages": [
        "en_US"
      ],
      "multiLanguageInstaller": false,
      "uninstallDisplayName": "Cutline by Raghav"
    },
    "afterPack": "build/afterPack.js"
  }
}
