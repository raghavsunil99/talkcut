{
  "name": "cutline",
  "version": "1.0.0",
  "description": "Talkcut by Raghav: edit audio and video by editing the transcript.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/edits.test.js test/frame.test.js test/tracks.test.js test/captions.test.js test/text.test.js test/speakers.test.js test/stock.test.js test/cloud.test.js test/keystore.test.js test/projects.test.js test/media.test.js test/transcribe.test.js",
    "build:whisper": "sh scripts/build-whisper.sh",
    "build:facedetect": "sh scripts/build-facedetect.sh",
    "dist:win": "ELECTRON_BUILDER_NSIS_DIR=${ELECTRON_BUILDER_NSIS_DIR:-$HOME/Library/Caches/cutline-nsis-3.13} electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "resedit": "^2.0.3"
  },
  "author": {
    "name": "Raghav",
    "email": "raghav.sunil99@gmail.com"
  },
  "build": {
    "appId": "com.raghav.talkcut",
    "productName": "Talkcut by Raghav",
    "copyright": "Built by Raghav",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/*.README",
      "!node_modules/ffmpeg-static/*.LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/win/bin",
          "to": "bin"
        },
        {
          "from": "vendor/win/whisper",
          "to": "whisper"
        },
        {
          "from": "vendor/win/vc_redist.x64.exe",
          "to": "vc_redist.x64.exe"
        },
        {
          "from": "vendor/win/ffmpeg.LICENSE",
          "to": "licenses/ffmpeg.LICENSE"
        }
      ],
      "artifactName": "Talkcut-by-Raghav-Setup-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Talkcut by Raghav",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "installerLanguages": [
        "en_US"
      ],
      "multiLanguageInstaller": false,
      "uninstallDisplayName": "Talkcut by Raghav"
    },
    "afterPack": "build/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "vendor/whisper.cpp/build/bin/whisper-cli",
          "to": "whisper/whisper-cli"
        },
        {
          "from": "vendor/facedetect/facedetect",
          "to": "facedetect"
        }
      ],
      "artifactName": "Talkcut-by-Raghav-${version}-mac-arm64.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Talkcut does not record audio."
      }
    },
    "dmg": {
      "title": "Talkcut by Raghav",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
